msgstr "لم يتم تسجيل أي وصف."

#: .\main\views.py:735
msgid "برای ارسال رزومه ابتدا باید وارد حساب کاربری خود شوید."
msgstr "لإرسال السيرة الذاتية يجب تسجيل الدخول أولاً."

#: .\main\views.py:740
msgid ""
"اعتبار حساب پرو شما صفر است. لطفاً برای ارسال رزومه حساب خود را شارژ کنید."
msgstr "رصيد حساب برو الخاص بك صفر. يرجى شحن حسابك لإرسال السيرة الذاتية."

#: .\main\views.py:744
msgid "شما قبلاً برای این موقعیت شغلی رزومه ارسال کرده‌اید."
msgstr "لقد أرسلت سيرتك الذاتية لهذا المنصب مسبقاً."

#: .\main\views.py:751
msgid "لطفاً یک رزومه برای ارسال انتخاب کنید."
msgstr "يرجى اختيار سيرة ذاتية للإرسال."

#: .\main\views.py:767
msgid ""
"رزومه شما با موفقیت برای این موقعیت شغلی ارسال شد و یک اعتبار پرو از حساب "
"شما کسر گردید."
msgstr ""
"تم إرسال سيرتك الذاتية بنجاح لهذا المنصب وتم خصم رصيد برو واحد من حسابك."

#: .\main\views.py:771
msgid "رزومه انتخاب‌شده معتبر نیست."
msgstr "السيرة الذاتية المختارة غير صالحة."

#: .\main\views.py:774
msgid ""
"اعتبار حساب پرو شما به اتمام رسیده است. لطفاً جهت ارسال رزومه حساب خود را "
"شارژ کنید."
msgstr "انتهى رصيد حساب برو الخاص بك. يرجى شحن حسابك لإرسال السيرة الذاتية."

#: .\main\views.py:800
