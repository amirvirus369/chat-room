msgstr "عني"

#: .\main\templates\employer-dashbord.html:362
msgid "توضیحات ثبت نشده است."
msgstr "لم يتم تسجيل أي وصف."

#: .\main\templates\employer-dashbord.html:371
msgid " سوابق شغلی (Experience)"
msgstr "الخبرات المهنية (Experience)"

#: .\main\templates\employer-dashbord.html:390
msgid "پیام / کاور لتر متقاضی:"
msgstr "رسالة / خطاب التغطية للمتقدم:"

#: .\main\templates\employer-dashbord.html:422
msgid " پیام شما به متقاضی (اختیاری)"
msgstr "رسالتك إلى المتقدم (اختياري)"

#: .\main\templates\employer-dashbord.html:427
msgid "مثلاً: رزومه شما تأیید شد. لطفاً برای هماهنگی تماس بگیرید..."
msgstr "مثال: تم قبول سيرتك الذاتية. يرجى التواصل للتنسيق..."

#: .\main\templates\employer-dashbord.html:432
msgid " این پیام قبلاً ثبت شده و قابل ویرایش نیست."
msgstr "تم تسجيل هذه الرسالة مسبقاً ولا يمكن تعديلها."

#: .\main\templates\employer-dashbord.html:444
msgid "تایید رزومه"
msgstr "قبول السيرة الذاتية"

#: .\main\templates\employer-dashbord.html:452
msgid "رد رزومه"
msgstr "رفض السيرة الذاتية"

#: .\main\templates\employer-dashbord.html:460
msgid "تماس با متقاضی"
msgstr "التواصل مع المتقدم"

#: .\main\templates\employer-dashbord.html:464
#: .\main\templates\freelancer-dashbord.html:187
msgid "بستن"
msgstr "إغلاق"

#: .\main\templates\employer-dashbord.html:537
msgid "   از پایان دادن اگهی مطمن هستید ؟  ."
msgstr "هل أنت متأكد من إنهاء الإعلان؟"

#: .\main\templates\employer-dashbord.html:625
msgid " درخواست متقاضی تایید شد "
msgstr "تم قبول طلب المتقدم"

#: .\main\templates\employer-dashbord.html:625
msgid " درخواست متقاضی رد شد."
msgstr "تم رفض طلب المتقدم."

#: .\main\templates\employer-dashbord.html:628
msgid "امکان تغییر وضعیت ندارد"
msgstr "لا يمكن تغيير الحالة"

#: .\main\templates\employer-dashbord.html:632
msgid "خطا با برقراری سرور لطفا دوباره تلاش کنید"
msgstr "خطأ في الاتصال بالخادم، يرجى المحاولة مرة أخرى"

#: .\main\templates\freelancer-dashbord.html:6
msgid "داشبورد فریلنسر | پیگیری رزومه‌های ارسالی | کار من"
msgstr "لوحة المستقل | متابعة السير الذاتية المرسلة | كار من"

#: .\main\templates\freelancer-dashbord.html:9
msgid ""
"پنل مدیریت و پیگیری وضعیت رزومه‌های ارسالی فریلنسرها و کارجویان در سامانه "
"کار من."
msgstr ""
"لوحة إدارة ومتابعة حالة السير الذاتية المرسلة للمستقلين والباحثين عن عمل في "
"منصة كار من."

#: .\main\templates\freelancer-dashbord.html:66
msgid " وضعیت رزومه‌های ارسال شده"
msgstr "حالة السير الذاتية المرسلة"

#: .\main\templates\freelancer-dashbord.html:68
msgid ""
"بر روی هر آگهی کلیک کنید تا وضعیت بررسی رزومه و جزئیات آن در سمت چپ نمایش "
"داده شود."
msgstr ""
"انقر على أي إعلان لعرض حالة مراجعة السيرة الذاتية وتفاصيلها على اليسار."

#: .\main\templates\freelancer-dashbord.html:72
msgid "جستجوی آگهی‌های بیشتر"
msgstr "البحث عن المزيد من الإعلانات"

#: .\main\templates\freelancer-dashbord.html:84
msgid " لیست درخواست‌ها "
msgstr "قائمة الطلبات"

#: .\main\templates\freelancer-dashbord.html:87
msgid " بروزرسانی سیستم"
msgstr "تحديث النظام"

#: .\main\templates\freelancer-dashbord.html:102
#: .\main\templates\freelancer-dashbord.html:181
msgid "پایان یافته"
msgstr "منتهية"

#: .\main\templates\freelancer-dashbord.html:113
msgid "در حال بررسی"
msgstr "قيد المراجعة"

#: .\main\templates\freelancer-dashbord.html:117
msgid "مشاهده شده"
msgstr "تمت المشاهدة"

#: .\main\templates\freelancer-dashbord.html:121
msgid "رد شده"
msgstr "مرفوضة"

#: .\main\templates\freelancer-dashbord.html:125
